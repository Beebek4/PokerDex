<main class="min-h-dvh mx-auto flex w-full max-w-xl flex-col justify-center px-5 py-12 sm:px-8">
  <img src={school_logo(@school, @app)} alt={school_name(@school)} class="mb-8 h-14 w-64 max-w-full object-cover object-center" />
  <h1 class="mt-3 text-3xl font-bold tracking-tight text-gray-950 sm:text-4xl">Practise one decision at a time.</h1>
  <p class="mt-4 text-base leading-7 text-gray-600">
    Short lessons and hand questions help you build sound habits. Every chip is fictional, and choices are judged by the information available at the time.
  </p>

  <%= if @app && @app.allow_guests? do %>
    <form action="/start" method="post" class="mt-9 space-y-6 rounded-3xl border border-gray-200 bg-white p-5 shadow-sm sm:p-7">
      <input type="hidden" name="_csrf_token" value={@csrf_token} />

      <div>
        <label for="experience-level" class="block text-sm font-semibold text-gray-900">How familiar are you with poker?</label>
        <select
          id="experience-level"
          name="experience_level"
          required
          class="mt-2 block w-full rounded-xl border-gray-300 py-3 text-base shadow-sm focus:border-cyan-600 focus:ring-cyan-600"
        >
          <option value="" selected disabled>Choose one</option>
          <option value="new">I’m new to Hold’em</option>
          <option value="know_rules">I know the rules</option>
          <option value="casual">I play casually</option>
        </select>
      </div>

      <div>
        <label for="learning-goal" class="block text-sm font-semibold text-gray-900">
          What would you like to work on? <span class="font-normal text-gray-500">(optional)</span>
        </label>
        <select id="learning-goal" name="learning_goal" class="mt-2 block w-full rounded-xl border-gray-300 py-3 text-base shadow-sm focus:border-cyan-600 focus:ring-cyan-600">
          <option value="">I’m happy to follow the basics</option>
          <option value="basics">Learn the basics</option>
          <option value="better_decisions">Make better decisions</option>
          <option value="specific_topic">Explore a specific topic</option>
        </select>
      </div>

      <button
        type="submit"
        class="w-full rounded-xl bg-cyan-700 px-5 py-3.5 text-base font-semibold text-white shadow-sm hover:bg-cyan-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-700"
      >
        Start learning as a guest
      </button>
      <p class="text-center text-sm text-gray-500">No account needed to begin. You can save your progress to an account later.</p>
    </form>
  <% else %>
    <div class="mt-9 rounded-3xl border border-amber-200 bg-amber-50 p-5 text-sm leading-6 text-amber-950" role="status">
      Guest learning is not configured for this app yet. Sign in if you already have an account, or ask the app owner to finish setup.
    </div>
  <% end %>

  <p class="mt-6 text-center text-sm text-gray-600">
    Already have an account? <.link href={~p"/users/login"} class="font-semibold text-cyan-800 underline underline-offset-4">Sign in</.link>
  </p>
</main>
