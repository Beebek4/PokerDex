<main class="min-h-dvh bg-[#1B111A] relative flex items-center justify-center overflow-hidden px-3 py-3 text-white sm:px-8 sm:py-6">
  <div
    class="bg-[radial-gradient(ellipse_at_18%_12%,rgba(95,75,102,0.55),transparent_42%),radial-gradient(ellipse_at_85%_90%,rgba(44,19,32,0.85),transparent_45%)] pointer-events-none absolute inset-0"
    aria-hidden="true"
  >
  </div>

  <div class="border-white/10 bg-[#241722]/95 shadow-black/40 relative grid w-full max-w-5xl overflow-hidden rounded-3xl border shadow-2xl md:grid-cols-[0.95fr_1.05fr]">
    <section class="border-white/10 bg-[#2C1320]/45 flex flex-col justify-center border-b px-5 py-5 sm:px-10 sm:py-8 md:border-r md:border-b-0 md:px-9 lg:px-12">
      <div class="mb-4 flex items-center gap-3 sm:mb-6 sm:gap-4">
        <img src={school_logo(@school, @app)} alt="" class="h-12 w-12 shrink-0 object-contain sm:h-16 sm:w-16" />
        <span class="text-2xl font-black tracking-tight sm:text-3xl">
          <span class="text-white">Poker</span><span class="text-[#F0D17E]">Dex</span>
        </span>
      </div>

      <p class="tracking-[0.2em] text-[#F0D17E] text-[10px] mb-2 font-extrabold uppercase sm:mb-3 sm:text-xs">Hold’em trainer</p>
      <h1 class="max-w-lg text-2xl font-black leading-tight tracking-tight text-white sm:text-4xl">
        Practise one decision at a time.
      </h1>
      <p class="text-[#D5D1DC] mt-2 max-w-lg text-sm leading-5 sm:mt-4 sm:text-base sm:leading-7">
        Build poker skills through play, puzzles, and clear lessons. All chips are fictional.
      </p>

      <ul class="text-[#E2DCE5] mt-7 hidden gap-3 text-sm font-semibold md:grid">
        <li class="flex items-center gap-2"><.icon name="tabler-coins" class="h-5 w-5 text-[#F0D17E]" /> Play against characters</li>
        <li class="flex items-center gap-2"><.icon name="tabler-cards" class="h-5 w-5 text-[#F0D17E]" /> Practise hands and decisions</li>
        <li class="flex items-center gap-2"><.icon name="tabler-book-2" class="h-5 w-5 text-[#F0D17E]" /> Learn the theory behind them</li>
      </ul>
    </section>

    <section class="px-5 py-5 sm:px-9 sm:py-8 lg:px-11">
      <h2 class="text-lg font-extrabold text-white sm:text-2xl">Start at your own pace</h2>
      <p class="text-[#A7ADC6] mt-1 text-xs leading-5 sm:mt-2 sm:text-sm sm:leading-6">Pick a starting level; you can change it later.</p>

      <%= if @app && @app.allow_guests? do %>
        <form action="/start" method="post" class="border-white/10 bg-[#301E30] mt-4 space-y-3 rounded-2xl border p-4 sm:mt-6 sm:space-y-5 sm:p-6">
          <input type="hidden" name="_csrf_token" value={@csrf_token} />

          <div>
            <label for="experience-level" class="block text-sm font-semibold text-white">How familiar are you with poker?</label>
            <select
              id="experience-level"
              name="experience_level"
              required
              class="border-white/15 bg-[#211721] mt-1.5 block w-full rounded-xl border py-2.5 text-sm text-white shadow-sm focus:border-[#D6B15F] focus:ring-[#D6B15F] sm:mt-2 sm:py-3 sm:text-base"
            >
              <option value="" selected disabled>Choose one</option>
              <option value="new">I’m new to Hold’em</option>
              <option value="know_rules">I know the rules</option>
              <option value="casual">I play casually</option>
            </select>
          </div>

          <div>
            <label for="learning-goal" class="block text-sm font-semibold text-white">
              What would you like to work on? <span class="text-[#A7ADC6] font-normal">(optional)</span>
            </label>
            <select
              id="learning-goal"
              name="learning_goal"
              class="border-white/15 bg-[#211721] mt-1.5 block w-full rounded-xl border py-2.5 text-sm text-white shadow-sm focus:border-[#D6B15F] focus:ring-[#D6B15F] sm:mt-2 sm:py-3 sm:text-base"
            >
              <option value="">I’m happy to follow the basics</option>
              <option value="basics">Learn the basics</option>
              <option value="better_decisions">Make better decisions</option>
              <option value="specific_topic">Explore a specific topic</option>
            </select>
          </div>

          <button
            type="submit"
            class="bg-poker-gold min-h-11 text-[#2C1320] shadow-black/20 w-full rounded-xl px-5 py-2.5 text-sm font-extrabold shadow-lg transition hover:bg-poker-gold-light focus-visible:outline-poker-gold focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 active:scale-[0.99] sm:min-h-12 sm:py-3 sm:text-base"
          >
            Start learning as a guest
          </button>
          <p class="text-[#A7ADC6] text-[10px] text-center leading-4 sm:text-xs sm:leading-5">No account needed. You can save progress to an account later.</p>
        </form>
      <% else %>
        <div class="border-amber-300/25 bg-amber-950/30 mt-6 rounded-2xl border p-5 text-sm leading-6 text-amber-100" role="status">
          Guest learning is not configured for this app yet. Sign in if you already have an account, or ask the app owner to finish setup.
        </div>
      <% end %>

      <p class="text-[#C8C4D0] mt-3 text-center text-xs sm:mt-6 sm:text-sm">
        Already have an account? <.link href={~p"/users/login"} class="font-bold text-[#F0D17E] underline underline-offset-4 hover:text-[#FFE59B]">Sign in</.link>
      </p>
    </section>
  </div>
</main>
