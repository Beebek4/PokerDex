<section class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="border-indigo-800/20 bg-indigo-900/95 sticky top-16 z-30 -mx-4 border-b px-4 py-3 text-white shadow-md backdrop-blur sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-4">
      <h1 class="text-lg font-bold sm:text-xl">Just Play</h1>
      <.link_button :if={@quick_play} navigate={~p"/c/#{@quick_play.course.slug}/#{@quick_play.lesson.id}"} color={:primary} class="shrink-0">
        Play a lesson
      </.link_button>
      <span :if={is_nil(@quick_play)} class="text-sm text-indigo-100">Puzzles coming soon</span>
    </div>
  </div>

  <div class="mt-8 grid gap-5 md:grid-cols-2">
    <article
      :for={section <- @sections}
      :if={section.track.course}
      class="group min-h-[15rem] flex flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm transition hover:shadow-lg"
    >
      <img src={section.cover} alt="" class="h-36 w-full object-cover" />
      <div class="flex flex-1 flex-col p-5">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <p class="text-sm font-semibold text-cyan-800"><%= section.lesson_count %> lessons</p>
            <h2 class="mt-2 text-xl font-bold text-gray-950"><%= section.title %></h2>
          </div>
          <.link
            :if={section.lessons == []}
            navigate={~p"/c/#{section.track.course.slug}"}
            class="inline-flex min-h-10 items-center rounded-xl bg-cyan-800 px-4 py-2 text-sm font-semibold text-white hover:bg-cyan-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-800"
          >
            Open puzzles
          </.link>
        </div>

        <div :if={section.lessons != []} class="mt-4 flex flex-1 flex-col gap-2">
          <.link
            :for={lesson <- section.lessons}
            navigate={~p"/c/#{section.track.course.slug}/#{lesson.id}"}
            class="inline-flex min-h-10 items-center justify-between rounded-xl bg-gray-50 px-3 py-2 text-sm font-medium text-gray-800 hover:bg-gray-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-800"
          >
            <%= lesson.name %>
            <.icon name="tabler-chevron-right" class="h-4 w-4 text-gray-400" />
          </.link>
        </div>

        <details class="group mt-4 border-t border-gray-100 pt-3">
          <summary class="flex w-fit cursor-pointer list-none items-center gap-2 rounded-lg py-1 text-sm font-semibold text-cyan-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-800">
            <span>More</span>
            <.icon name="tabler-chevron-down" class="h-4 w-4 transition-transform group-open:rotate-180" />
          </summary>
          <p class="mt-2 max-w-2xl text-sm leading-6 text-gray-600"><%= section.description %></p>
        </details>
      </div>
    </article>
  </div>
</section>
