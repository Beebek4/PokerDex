<section class="mx-auto w-full max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
  <.link navigate={~p"/progress"} class="text-sm font-semibold text-cyan-800 underline">Back to Progress</.link>
  <div class="mt-5 rounded-2xl border border-amber-200 bg-amber-50 p-4">
    <p class="text-xs font-semibold uppercase tracking-wide text-amber-900">Why this is due</p>
    <p class="mt-1 text-sm leading-6 text-amber-950"><%= @review_reason %> This is a different authored scenario for the same skill.</p>
  </div>

  <div class="mt-6">
    <.lesson_step step={@review_step} selected={@selected_option} />
  </div>

  <form :if={!@selection_saved?} id="review-answer" phx-submit="answer" class="mt-6">
    <fieldset>
      <legend class="mb-3 font-semibold text-gray-950">
        <%= if get_in(@review_step.poker_scenario, ["question", "type"]) == "hand_ranking", do: "Choose the hand category", else: "Choose your action" %>
      </legend>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
        <label
          :for={option <- @review_step.options}
          class="cursor-pointer rounded-2xl border border-gray-200 bg-white p-4 text-center font-semibold text-gray-900 shadow-sm has-[:checked]:border-cyan-500 has-[:checked]:bg-cyan-50"
        >
          <input type="radio" name="selected_option" value={option.id} class="sr-only" required />
          <%= option.title %>
        </label>
      </div>
    </fieldset>
    <.button type="submit" class="mt-5 w-full sm:w-auto">Check answer</.button>
  </form>

  <section :if={@selection_saved?} class="mt-6 rounded-2xl bg-cyan-50 p-5">
    <.feedback_option selected={@selected_option} options={@review_step.options} scenario={@review_step.poker_scenario} />
    <.button type="button" phx-click="done" class="mt-4 w-full sm:w-auto">Done with review</.button>
  </section>
</section>
