<section class="mx-auto w-full max-w-3xl px-4 py-8 text-white sm:px-6 lg:px-8">
  <.link navigate={~p"/progress"} class="text-sm font-semibold text-poker-gold underline underline-offset-4">Back to Progress</.link>
  <div class="border-poker-gold/25 bg-[#453047] mt-5 rounded-2xl border p-4">
    <p class="text-poker-gold text-xs font-semibold uppercase tracking-wide">Why this is due</p>
    <p class="text-[#E2DCE5] mt-1 text-sm leading-6"><%= @review_reason %> This is a different authored scenario for the same skill.</p>
  </div>

  <div class="mt-6">
    <.lesson_step step={@review_step} selected={@selected_option} />
  </div>

  <form :if={!@selection_saved?} id="review-answer" phx-submit="answer" class="mt-6">
    <fieldset>
      <legend class="mb-3 font-semibold text-white">
        <%= if get_in(@review_step.poker_scenario, ["question", "type"]) == "hand_ranking", do: "Choose the hand category", else: "Choose your action" %>
      </legend>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
        <label
          :for={option <- @review_step.options}
          class="border-white/15 bg-[#453047] cursor-pointer rounded-2xl border p-4 text-center font-semibold text-white shadow-sm has-[:checked]:border-poker-gold has-[:checked]:bg-[#5F4B66]"
        >
          <input type="radio" name="selected_option" value={option.id} class="sr-only" required />
          <%= option.title %>
        </label>
      </div>
    </fieldset>
    <.button type="submit" class="mt-5 w-full sm:w-auto">Check answer</.button>
  </form>

  <section :if={@selection_saved?} class="border-white/10 bg-[#351B2B] mt-6 rounded-2xl border p-5 text-white">
    <.feedback_option selected={@selected_option} options={@review_step.options} scenario={@review_step.poker_scenario} />
    <.button type="button" phx-click="done" class="mt-4 w-full sm:w-auto">Done with review</.button>
  </section>
</section>
