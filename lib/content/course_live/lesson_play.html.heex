<form
  id="play"
  phx-submit="next"
  phx-hook={if @current_user.sound_effects?, do: "LessonSoundEffect", else: nil}
  class="grid-rows-[min-content_1fr_min-content] min-h-dvh bg-[#2C1320] absolute top-0 left-0 grid h-full w-full overflow-hidden text-white"
>
  <input type="hidden" name="step_id" value={@current_step.id} />
  <header class="px-4 pt-4">
    <div class="flex gap-x-4">
      <div :if={@puzzle_mode?} class="min-h-10 text-poker-gold flex flex-1 items-center text-sm font-semibold">Puzzles</div>
      <.progress :if={!@puzzle_mode?} total={@step_count} current={@current_step.order} />

      <.link_button
        kind={:icon}
        icon="tabler-x"
        navigate={if @puzzle_mode?, do: ~p"/practice", else: ~p"/c/#{@course.slug}"}
        data-confirm={if @puzzle_mode?, do: nil, else: dgettext("courses", "Your progress in this lesson will be lost. Would you like to quit?")}
        color={:alert_light}
      >
        <span class="sr-only"><%= gettext("Close") %></span>
      </.link_button>
    </div>
    <p :if={!@puzzle_mode?} class="text-[#A7ADC6] mx-auto mt-2 max-w-3xl text-xs font-medium"><%= @lesson.name %></p>
  </header>

  <article class="mx-auto flex max-w-3xl flex-col items-center overflow-y-auto p-8 before:content-[''] before:flex-1 after:content-[''] after:flex-1 sm:px-16">
    <.lesson_step step={@current_step} selected={@selected_option} />

    <section :if={@current_step.suggested_courses != []} class="grid grid-cols-2 gap-2 pt-8">
      <.link
        :for={suggestion <- @current_step.suggested_courses}
        navigate={~p"/c/#{suggestion.course.slug}"}
        class="flex items-center justify-center gap-2 rounded-lg border border-white/10 bg-white/5 p-2 text-center text-xs font-semibold text-poker-gold hover:bg-white/10"
      >
        <%= suggestion.course.name %> <.icon name="tabler-external-link" class="w-3 h-3" />
      </.link>
    </section>

    <div :if={@current_step.kind == :open_ended} class="w-full pt-8">
      <.input type="textarea" name="answer" value="" />
    </div>

    <% next? = @current_step.kind == :readonly || @selected_option %>

    <section
      :if={@puzzle_mode? and @current_step.kind == :quiz and @options != []}
      class={[
        "mt-8 grid w-full gap-3",
        length(@options) == 2 && "grid-cols-2",
        length(@options) == 3 && "grid-cols-2 sm:grid-cols-3",
        length(@options) >= 4 && "grid-cols-2 sm:grid-cols-3 md:grid-cols-4"
      ]}
      aria-label="Choose your action"
    >
      <button
        :for={option <- @options}
        type="button"
        phx-click="choose-option"
        phx-value-id={@current_step.id}
        phx-value-option={option.id}
        disabled={!is_nil(@selected_option)}
        aria-pressed={@selected_option && @selected_option.id == option.id}
        class={[
          "min-h-16 bg-[#56667A] flex w-full cursor-pointer flex-col items-center justify-center gap-2 rounded-2xl border p-4 text-center text-sm font-semibold text-white transition active:scale-[0.98] disabled:cursor-default",
          (is_nil(@selected_option) || (@selected_option.id != option.id && not option.correct?)) && "shadow-b-gray border-[#8797AF] hover:border-[#A7ADC6] hover:bg-[#65758A]",
          user_selected_wrong_option?(@selected_option, option) && "shadow-b-pink bg-[#704452] border-pink-300 text-white",
          @selected_option && option.correct? && "shadow-b-teal bg-[#365D58] border-teal-200 text-white"
        ]}
      >
        <img :if={option.image} src={Storage.get_url(option.image)} alt="" class="h-12 w-12 object-cover" />
        <%= option.title %>
      </button>
    </section>

    <section
      :if={!@puzzle_mode? and @current_step.kind == :quiz and @current_step.options != []}
      class={[
        "mt-8 grid w-full gap-4",
        length(@current_step.options) == 2 && "grid-cols-2",
        length(@current_step.options) == 3 && "grid-cols-2 sm:grid-cols-3",
        length(@current_step.options) >= 4 && "grid-cols-2 sm:grid-cols-3 md:grid-cols-4"
      ]}
    >
      <div :for={option <- @options} class="relative">
        <input
          id={"select-option-#{option.id}"}
          type="radio"
          name="selected_option"
          value={option.id}
          class="peer absolute opacity-0"
          required
          disabled={not is_nil(@selected_option)}
        />

        <label
          for={"select-option-#{option.id}"}
          role="button"
          class={[
            "bg-[#56667A] flex h-full cursor-pointer flex-col items-center justify-center gap-4 rounded-2xl border p-4 text-center text-sm font-semibold text-white peer-checked:shadow-b-cyan peer-checked:border-poker-gold",
            (is_nil(@selected_option) || (@selected_option.id != option.id && not option.correct?)) && "shadow-b-gray border-[#8797AF] active:shadow-b-gray-pressed",
            user_selected_wrong_option?(@selected_option, option) && "shadow-b-pink border-pink-300",
            @selected_option && option.correct? && "shadow-b-teal border-teal-100"
          ]}
        >
          <img :if={option.image} src={Storage.get_url(option.image)} alt={option.title} class="h-16 w-16 object-cover" />
          <%= option.title %>
        </label>
      </div>
    </section>
  </article>

  <div :if={@puzzle_mode? and @selected_option} class="border-white/10 bg-[#351B2B] z-50 flex flex-col gap-3 border-t p-3 text-white sm:flex-row sm:items-center sm:p-4">
    <div class="text-[#E2DCE5] min-w-0 flex-1">
      <.feedback_option options={@current_step.options} selected={@selected_option} scenario={@current_step.poker_scenario} />
    </div>
    <button
      type="button"
      phx-click="next-puzzle"
      phx-value-id={@current_step.id}
      class="min-h-12 bg-poker-gold text-[#2C1320] shadow-black/20 inline-flex w-full shrink-0 items-center justify-center gap-2 rounded-xl px-5 text-sm font-bold shadow-md transition hover:bg-poker-gold-light focus-visible:outline-poker-gold focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 active:scale-[0.98] sm:w-auto"
    >
      Next puzzle <.icon name="tabler-arrow-right" class="h-4 w-4" />
    </button>
  </div>

  <div
    :if={!@puzzle_mode?}
    class={[
      "z-50 flex flex-col gap-4 border-t-2 p-4 sm:flex-row sm:items-center",
      is_nil(@selected_option) && "border-white/10 bg-[#351B2B] text-white",
      @selected_option && @selected_option.correct? && "border-teal-100 bg-teal-50 text-teal-700",
      @selected_option && not @selected_option.correct? && "border-pink-100 bg-pink-50 text-pink-700"
    ]}
  >
    <div class={["w-full sm:block", is_nil(@selected_option) && "hidden"]}>
      <.feedback_option :if={@selected_option} options={@current_step.options} selected={@selected_option} scenario={@current_step.poker_scenario} />
    </div>

    <.button
      type="submit"
      size={:lg}
      color={confirm_color(@current_step.options, @selected_option)}
      icon={if next?, do: "tabler-chevron-right", else: "tabler-checks"}
      phx-disable-with={dgettext("courses", "Confirming...")}
      shadow
      class="w-full sm:w-fit"
    >
      <%= if next?, do: dgettext("courses", "Next step"), else: gettext("Confirm") %>
    </.button>
  </div>
</form>
