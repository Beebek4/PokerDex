<section class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
  <p class="text-sm font-semibold uppercase tracking-wide text-cyan-800">Theory</p>
  <h1 class="mt-2 text-3xl font-bold tracking-tight text-gray-950">Build your Hold’em foundations</h1>
  <p class="mt-2 max-w-2xl text-gray-600">Learn the rules, read the board, and make better decisions one short lesson at a time.</p>

  <.course_list id="courses-list" courses={@streams.courses} />
</section>
