<section class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="mb-8">
    <p class="text-sm font-semibold uppercase tracking-wide text-cyan-800">Your learning space</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-gray-950">Welcome back, <%= @current_user.first_name || "learner" %></h1>
    <p class="mt-2 max-w-2xl text-gray-600">Build your Hold’em foundations with short, focused lessons. Chips are fictional; progress is about practice, not winnings.</p>
  </div>

  <section :if={@next_lesson && (@resume? || is_nil(@due_review))} class="rounded-3xl bg-slate-950 p-6 text-white sm:p-8">
    <p class="text-sm font-semibold text-cyan-300"><%= if @resume?, do: "Pick up where you left off", else: "Your next step" %></p>
    <h2 class="mt-2 text-2xl font-bold"><%= @next_lesson.lesson.name %></h2>
    <p class="mt-2 max-w-xl text-slate-300"><%= @next_lesson.lesson.description %></p>
    <.link_button navigate={~p"/c/#{@next_lesson.course.slug}/#{@next_lesson.lesson.id}"} color={:primary} class="mt-6">
      <%= if @resume?, do: "Continue lesson", else: "Start lesson" %>
    </.link_button>
  </section>

  <section :if={@due_review && !@resume?} class="rounded-3xl bg-amber-950 p-6 text-white sm:p-8">
    <p class="text-sm font-semibold text-amber-200">A skill is ready for a second look</p>
    <h2 class="mt-2 text-2xl font-bold"><%= @due_review.skill |> String.replace(".", " ") |> String.capitalize() %></h2>
    <p class="mt-2 max-w-xl text-amber-100"><%= @due_review.reason %></p>
    <.link_button navigate={~p"/review/#{@due_review.course.slug}/#{@due_review.lesson.id}/#{@due_review.step.id}"} color={:primary} class="mt-6">
      Try a different hand
    </.link_button>
  </section>

  <section :if={is_nil(@next_lesson) && is_nil(@due_review)} class="rounded-3xl bg-slate-950 p-6 text-white sm:p-8">
    <p class="text-sm font-semibold text-cyan-300">Your next step</p>
    <h2 class="mt-2 text-2xl font-bold">Keep practising at your own pace</h2>
    <p class="mt-2 text-slate-300">You’ve completed the current lessons. More reviewed practice can be added as the curriculum grows.</p>
    <.link_button navigate={~p"/practice"} color={:primary} class="mt-6">Explore puzzles</.link_button>
  </section>

  <div class="mt-10 flex items-end justify-between gap-4">
    <div>
      <h2 class="text-xl font-bold text-gray-950">Theory tracks</h2>
      <p class="mt-1 text-sm text-gray-600">Start with the rules, then build preflop and flop skills.</p>
    </div>
    <.link navigate={~p"/courses"} class="hidden text-sm font-semibold text-cyan-800 underline sm:block">Browse theory</.link>
  </div>

  <div class="mt-4 grid gap-4 md:grid-cols-3">
    <article :for={track <- @tracks} class="flex flex-col rounded-2xl border border-gray-200 bg-white p-5 shadow-sm">
      <div class="flex-1">
        <h3 class="text-lg font-semibold text-gray-950"><%= track.course.name %></h3>
        <p class="mt-2 text-sm leading-6 text-gray-600"><%= track.course.description %></p>
      </div>
      <div class="mt-5 flex items-center justify-between text-sm text-gray-600">
        <span><%= length(track.lessons) %> short lessons</span>
        <span><%= track.progress %>% complete</span>
      </div>
      <.link navigate={~p"/c/#{track.course.slug}"} class="mt-4 font-semibold text-cyan-800 underline underline-offset-4">View track</.link>
    </article>
  </div>
</section>
