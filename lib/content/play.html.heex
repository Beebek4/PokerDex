<%= if @play_screen == :journey do %>
  <section class="play-journey-screen" aria-labelledby="play-journey-title">
    <div class="play-journey-content">
      <div class="play-journey-heading">
        <p class="play-journey-eyebrow">THE POKERDEX MAP</p>
        <h1 id="play-journey-title">Choose your next challenge</h1>
        <p :if={@preview_all_opponents}>Visual preview mode · all opponents unlocked · match results are not saved.</p>
        <p :if={!@preview_all_opponents}>
          Beat new opponents to earn Respect. Losses keep your Respect, and repeat wins earn chips only. The Garage Tournament costs 500 chips.
        </p>
      </div>

      <div :if={@unresumable_match} class="border-[#A7ADC6]/30 bg-[#2C1320]/90 rounded-2xl border p-4 text-left shadow-lg sm:p-5" role="status">
        <h2 class="text-base font-bold text-white sm:text-lg">Your previous match can’t be resumed</h2>
        <p class="text-[#D3CDDA] mt-1 text-sm">The hand is kept in memory while you play. Refund its entry to leave it safely and start another match.</p>
        <button
          type="button"
          phx-click="refund-pending-match"
          phx-disable-with="Refunding…"
          class="bg-poker-gold text-[#2C1320] min-h-10 mt-3 rounded-xl px-4 text-sm font-bold transition hover:bg-poker-gold-light"
        >
          Refund entry and start fresh
        </button>
      </div>

      <section
        :for={location <- @journey_locations}
        class={["play-location", location.id == "home" && "play-location--home", location.id == "house-tournament" && "play-location--tournament"]}
        aria-labelledby={"location-#{location.id}"}
      >
        <header class="play-location-heading">
          <span class="play-location-icon" aria-hidden="true">
            <.icon :if={location.id == "home"} name="tabler-home" class="h-5 w-5" />
            <.icon :if={location.id == "house-tournament"} name="tabler-trophy" class="h-5 w-5" />
          </span>
          <div>
            <p><%= location.eyebrow %></p>
            <h2 id={"location-#{location.id}"}><%= location.name %></h2>
            <span><%= location.detail %></span>
          </div>
        </header>

        <div :if={location.id == "home"} class="play-route" role="list" aria-label="Home opponents">
          <svg class="play-route-road" viewBox="0 0 100 720" preserveAspectRatio="none" aria-hidden="true">
            <path class="play-route-road-edge" d="M25 61 C25 120 75 120 75 180 S25 240 25 299 S75 360 75 418 S25 480 25 537 S75 600 75 659" />
            <path class="play-route-road-center" d="M25 61 C25 120 75 120 75 180 S25 240 25 299 S75 360 75 418 S25 480 25 537 S75 600 75 659" />
          </svg>
          <div :for={opponent <- location.opponents} class={["play-route-stop", opponent.side == :left && "is-left"]} role="listitem">
            <div class={["play-route-pin", opponent.status == :open && "is-open"]} aria-hidden="true">
              <.icon :if={opponent.status == :locked} name="tabler-lock" class="h-5 w-5" />
            </div>
            <button
              :if={opponent.status == :open}
              type="button"
              phx-click="start-match"
              phx-value-opponent-id={opponent.id}
              data-retention-event="ui.interaction"
              data-study-screen="play"
              data-study-control="start_match"
              data-study-opponent-id={opponent.id}
              disabled={not is_nil(@unresumable_match)}
              aria-label={"Play #{opponent.name}"}
              class={["play-route-character-trigger", not is_nil(@unresumable_match) && "cursor-not-allowed opacity-50"]}
            >
              <img
                src={character_image_path(opponent.id)}
                alt=""
                class={[
                  "play-route-character-image",
                  map_flipped_character?(opponent.id) && "play-route-character-image--flipped",
                  opponent.id == "teddy" && "play-route-teddy"
                ]}
              />
            </button>
            <div :if={opponent.status == :locked} class="play-route-character-trigger" aria-hidden="true">
              <img
                src={character_image_path(opponent.id)}
                alt=""
                class={[
                  "play-route-character-image",
                  map_flipped_character?(opponent.id) && "play-route-character-image--flipped",
                  opponent.id == "teddy" && "play-route-teddy"
                ]}
              />
            </div>

            <button
              :if={opponent.status == :open}
              type="button"
              phx-click="show-bot-profile"
              phx-value-profile-id={opponent.id}
              data-retention-event="opponent.profile_opened"
              data-study-screen="play"
              data-study-control="profile_open"
              data-study-opponent-id={opponent.id}
              class="play-route-card is-open w-full cursor-pointer text-left"
              aria-label={"View #{opponent.name}'s playstyle and stats"}
            >
              <span class="play-route-label"><%= opponent.level %></span>
              <strong><%= opponent.name %></strong>
              <span class="play-route-economy">
                <%= if opponent.buy_in == 0 do %>
                  Free warm-up · Win <%= opponent.respect_reward %> Respect
                <% else %>
                  Buy-in <%= chip_text(opponent.buy_in) %> · <%= blinds_text(opponent) %> blinds
                <% end %>
              </span>
              <span :if={opponent.buy_in > 0} class="play-route-requirement"><%= opponent.lock_reason %></span>
              <span class="play-route-opponent"><%= opponent.personality %> · <%= opponent.style %> · <%= difficulty_label(opponent) %></span>
              <span class="play-route-preview"><%= opponent.preview %></span>
              <span class="play-route-profile-cta">Opponent read <.icon name="tabler-arrow-up-right" class="h-3.5 w-3.5" /></span>
            </button>

            <button
              :if={opponent.status == :locked}
              type="button"
              phx-click="show-bot-profile"
              phx-value-profile-id={opponent.id}
              data-retention-event="opponent.profile_opened"
              data-study-screen="play"
              data-study-control="profile_open"
              data-study-opponent-id={opponent.id}
              class="play-route-card is-locked w-full cursor-pointer text-left"
              aria-label={"View #{opponent.name}'s playstyle and stats"}
            >
              <span class="play-route-label"><%= opponent.level %></span>
              <strong><%= opponent.name %></strong>
              <span class="play-route-economy">Buy-in <%= chip_text(opponent.buy_in) %> · <%= blinds_text(opponent) %> blinds</span>
              <span class="play-route-requirement"><%= opponent.lock_reason %></span>
              <span class="play-route-opponent"><%= opponent.personality %> · <%= opponent.style %> · <%= difficulty_label(opponent) %></span>
              <span class="play-route-preview"><%= opponent.preview %></span>
              <span class="play-route-profile-cta">Opponent read <.icon name="tabler-arrow-up-right" class="h-3.5 w-3.5" /></span>
            </button>
          </div>
        </div>

        <article
          :if={location.id == "house-tournament"}
          class={["play-tournament-stop", location.status == :open && "is-open"]}
          aria-label={"#{location.name}, #{location.status}"}
        >
          <span class="play-tournament-pin" aria-hidden="true">
            <.icon :if={location.status == :locked} name="tabler-lock" class="h-6 w-6" />
            <img :if={location.status == :open} src={~p"/images/poker/bracelets/garage_bracelet.png"} alt="" class="play-tournament-bracelet" />
          </span>
          <div>
            <span class="play-route-label">
              <%= if @preview_all_opponents,
                do: "PREVIEW ACCESS · MULTIWAY TABLE",
                else: if(location.requirements_met?, do: "COMING NEXT · MULTIWAY TABLE", else: "LOCKED · AFTER DAD") %>
            </span>
            <strong><%= location.name %></strong>
            <span class="play-route-economy">Entry <%= chip_text(location.buy_in) %> chips</span>
            <span class="play-route-requirement">
              <%= if @preview_all_opponents,
                do: "Preview mode · results are not saved",
                else:
                  if(location.requirements_met?, do: "Chips and Respect collected", else: "Needs #{location.respect_required} Respect and #{chip_text(location.buy_in)} chips") %>
            </span>
            <span class="play-route-opponent"><%= location.personality %> · <%= location.style %></span>
            <span class="play-route-preview"><%= location.preview %></span>
            <button
              :if={location.status == :open}
              type="button"
              phx-click="start-tournament"
              disabled={not is_nil(@unresumable_match)}
              class={["play-tournament-action-button", not is_nil(@unresumable_match) && "cursor-not-allowed opacity-50"]}
            >
              Play tournament
            </button>
          </div>
        </article>
      </section>

      <p class="play-route-footnote">
        Earn Respect by beating new family opponents; losses never remove it, and repeat wins earn chips only. The first Garage Tournament victory adds one Respect.
      </p>
    </div>
  </section>
<% else %>
  <section class="play-shell" aria-label="Poker game">
    <header class="play-topbar">
      <h1 class="sr-only"><%= if @is_tournament, do: "Garage Tournament", else: "Heads-up table" %></h1>
      <button type="button" phx-click="back-to-journey" class="play-exit" aria-label="Return to map">
        <.icon name="tabler-chevron-left" class="h-5 w-5" />
        <span class="hidden sm:inline">Map</span>
      </button>

      <div class="flex min-w-0 items-center gap-2">
        <span class="font-semibold tracking-tight"><%= @opponent.name %></span>
        <span class="text-white/50">·</span>
        <span class="text-white/75 truncate text-sm"><%= @game_view.round %></span>
        <% current_blinds = if @is_tournament, do: @tournament_blinds, else: @heads_up_blinds %>
        <span class="border-poker-gold/30 bg-black/25 text-poker-gold rounded-full border px-2 py-1 text-xs font-semibold" aria-label="Current blinds">
          <%= chip_text(elem(current_blinds, 0)) %>/<%= chip_text(elem(current_blinds, 1)) %>
        </span>
      </div>

      <button type="button" phx-click="open-hand-rankings" aria-label="Open poker hand rankings" class="play-rankings-button">
        <.icon name="tabler-cards" class="h-4 w-4" />
        <span>Hand Rankings</span>
      </button>
    </header>

    <div class="play-table-area">
      <div class="play-backdrop" aria-hidden="true">
        <img :if={@is_tournament} src={~p"/images/poker/backgrounds/garage_storybook_landscape.png"} alt="" class="h-full w-full object-cover" />
        <img :if={!@is_tournament} src={~p"/images/poker/backgrounds/livingroom_background.png"} alt="" class="h-full w-full object-cover" />
      </div>

      <div class={["play-table-stage", @is_tournament && "play-table-stage--tournament"]}>
        <aside class="play-player-panel" aria-label="Your player status">
          <div
            class={["play-avatar play-avatar--character play-avatar--hero", @is_tournament && "play-avatar--hero-tournament", player_character_class(@current_user)]}
            aria-hidden="true"
          >
            <img src={player_character_path(@current_user)} alt="" />
          </div>
          <span class="play-player-name">You</span>
          <span class="play-player-role"><%= role_text(@game_view, 0) %></span>
          <div :if={!@is_tournament} class="play-health-shell" aria-label="Your chip health">
            <progress
              class="play-health-track"
              max="100"
              value={Zoonk.Content.PokerHealth.green_width(@hero_health_chips, @match_start_chips)}
              aria-label="Your remaining chips"
              aria-valuenow={Zoonk.Content.PokerHealth.green_width(@hero_health_chips, @match_start_chips)}
            >
            </progress>
            <progress
              :if={@hero_health_chips > @match_start_chips}
              class="play-health-overflow"
              max="100"
              value={Zoonk.Content.PokerHealth.gold_width(@hero_health_chips, @match_start_chips)}
              aria-label="Your chips above starting stack"
            >
            </progress>
          </div>
          <% hero_all_in? = @game_view.round != "Complete" and Enum.at(@game_view.player_all_in, 0, false) %>
          <span :if={@game_view.hero_stack > 0} class="play-player-stack">
            <span class="play-stack-chip" aria-hidden="true"></span><%= chip_text(@game_view.hero_stack) %>
          </span>
          <span :if={hero_all_in?} class="play-player-status is-all-in">ALL IN</span>
          <span :if={@game_view.hero_stack <= 0 and not hero_all_in?} class="play-player-status">OUT</span>
        </aside>

        <div class="play-table" role="region" aria-label={if @is_tournament, do: "Garage Tournament poker table", else: "Heads-up poker table"}>
          <img src={~p"/images/poker/tables/poker_table1.png"} alt="" class="pointer-events-none absolute inset-0 h-full w-full select-none object-cover" />

          <div :if={!@is_tournament} class="left-[82%] top-[42%] w-[18%] absolute z-10 flex items-center justify-center">
            <div :if={@game_view.bot_cards == []} class="opponent-card-back max-w-[6.5rem] w-full" role="img" aria-label={"#{@opponent.name}'s hole cards face down"}>
              <img src={~p"/images/poker/opp_cards.png"} alt="" class="h-full w-full object-contain" />
            </div>
            <div :if={@game_view.bot_cards != []} class="gap-[2%] grid w-full grid-cols-2" role="group" aria-label={"#{@opponent.name}'s hole cards revealed"}>
              <.playing_card
                :for={card <- @game_view.bot_cards}
                id={"hand-#{@hand_id}-bot-card-#{card}"}
                card={card}
                highlight={card in Enum.at(@game_view.player_best_fives, 1, [])}
              />
            </div>
          </div>

          <div
            class="left-[20%] top-[34%] w-[60%] gap-[2%] absolute z-10 grid grid-cols-5"
            role="group"
            aria-label={if @game_view.board == [], do: "Community cards not dealt yet", else: "Community cards: #{Enum.map_join(@game_view.board, ", ", &card_label/1)}"}
          >
            <.playing_card
              :for={{card, index} <- Enum.with_index(@game_view.board)}
              id={"hand-#{@hand_id}-board-card-#{index}-#{card}"}
              delay={if(index < 3, do: index * 65, else: 0)}
              card={card}
              highlight={card in Enum.flat_map(@game_view.player_best_fives, & &1)}
            />
          </div>

          <span :if={!@is_tournament && @game_view.dealer_idx == 0} class="play-dealer-button left-[17%] top-[61%] absolute z-20" role="img" aria-label="Dealer button · You">
            D
          </span>
          <span
            :if={!@is_tournament && @game_view.dealer_idx == 1}
            class="play-dealer-button right-[17%] top-[61%] absolute z-20"
            role="img"
            aria-label={"Dealer button · #{@opponent.name}"}
          >
            D
          </span>

          <.pot_display id={"hand-#{@hand_id}-pot-#{@game_view.pot}"} amount={chip_text(@game_view.pot)} pot={@game_view.pot} initial_buy_in={@match_start_chips} />

          <div
            class={["play-hero-hole-cards", @is_tournament && "play-hero-hole-cards--tournament"]}
            role="group"
            aria-label={"Your hand: #{Enum.map_join(@game_view.hero_cards, ", ", &card_label/1)}"}
          >
            <.playing_card
              :for={card <- @game_view.hero_cards}
              id={"hand-#{@hand_id}-hero-card-#{card}"}
              card={card}
              folded={@hero_folded}
              highlight={card in @game_view.best_five}
            />
          </div>

          <div
            :for={seat <- @tournament_seats}
            :if={@is_tournament && !Enum.at(@game_view.player_folded, tournament_player_index(@tournament_players, seat.opponent.id), false)}
            class={["play-tournament-hole-position", "play-tournament-hole-position--#{seat.position}"]}
            role="group"
            aria-label={"#{seat.opponent.name}'s hole cards"}
          >
            <% seat_idx = tournament_player_index(@tournament_players, seat.opponent.id) %>
            <div :if={Enum.at(@game_view.player_hole_cards, seat_idx, []) == []} class="opponent-card-back play-tournament-hole-back" aria-hidden="true">
              <img src={~p"/images/poker/opp_cards.png"} alt="" />
            </div>
            <div :if={Enum.at(@game_view.player_hole_cards, seat_idx, []) != []} class="play-tournament-hole-cards">
              <.playing_card
                :for={card <- Enum.at(@game_view.player_hole_cards, seat_idx, [])}
                id={"hand-#{@hand_id}-tournament-#{seat_idx}-#{card}"}
                card={card}
                highlight={card in Enum.at(@game_view.player_best_fives, seat_idx, [])}
              />
            </div>
          </div>
        </div>

        <aside :if={!@is_tournament} class={["play-player-panel", "play-player-panel--opponent--#{@opponent.id}"]} aria-label={"#{@opponent.name}'s player status"}>
          <button
            type="button"
            phx-click="show-bot-profile"
            phx-value-profile-id={@opponent.id}
            aria-label={"View #{@opponent.name}'s playstyle"}
            title={"View #{@opponent.name}'s playstyle"}
            data-retention-event="opponent.profile_opened"
            data-study-screen="play"
            data-study-control="profile_open"
            data-study-opponent-id={@opponent.id}
            class={[
              "play-avatar play-avatar--character play-avatar--opponent play-opponent-image-trigger",
              "play-avatar--opponent--#{@opponent.id}",
              game_flipped_character?(@opponent.id) && "play-avatar--opponent--flipped"
            ]}
          >
            <img src={character_image_path(@opponent.id)} alt="" />
          </button>
          <span class="play-player-name"><%= @opponent.name %></span>
          <span class="play-player-role"><%= role_text(@game_view, 1) %></span>
          <div class="play-health-shell" aria-label={"#{@opponent.name} chip health"}>
            <progress
              class="play-health-track"
              max="100"
              value={Zoonk.Content.PokerHealth.green_width(@bot_health_chips, @match_start_chips)}
              aria-label="Opponent remaining chips"
              aria-valuenow={Zoonk.Content.PokerHealth.green_width(@bot_health_chips, @match_start_chips)}
            >
            </progress>
            <progress
              :if={@bot_health_chips > @match_start_chips}
              class="play-health-overflow"
              max="100"
              value={Zoonk.Content.PokerHealth.gold_width(@bot_health_chips, @match_start_chips)}
              aria-label="Opponent chips above starting stack"
            >
            </progress>
          </div>
          <% opponent_stack = Enum.at(@game_view.player_stacks, 1, @game_view.bot_stack) %>
          <% opponent_all_in? = @game_view.round != "Complete" and Enum.at(@game_view.player_all_in, 1, false) %>
          <span :if={opponent_stack > 0} class="play-player-stack">
            <span class="play-stack-chip" aria-hidden="true"></span><%= chip_text(opponent_stack) %>
          </span>
          <span :if={opponent_all_in?} class="play-player-status is-all-in">ALL IN</span>
          <span :if={opponent_stack <= 0 and not opponent_all_in?} class="play-player-status">OUT</span>
        </aside>

        <div :if={@is_tournament} class="play-tournament-side-reserve" aria-hidden="true"></div>

        <aside
          :for={seat <- @tournament_seats}
          :if={@is_tournament}
          class={[
            "play-tournament-live-seat",
            "play-tournament-seat--#{seat.position}",
            Enum.at(@game_view.player_stacks, tournament_player_index(@tournament_players, seat.opponent.id), 0) <= 0 &&
              (@game_view.round == "Complete" || !Enum.at(@game_view.player_all_in, tournament_player_index(@tournament_players, seat.opponent.id), false)) && "is-eliminated",
            Enum.at(@game_view.player_folded, tournament_player_index(@tournament_players, seat.opponent.id), false) && "is-folded",
            @game_view.round != "Complete" && Enum.at(@game_view.player_all_in, tournament_player_index(@tournament_players, seat.opponent.id), false) && "is-all-in"
          ]}
          aria-label={"#{seat.opponent.name}'s tournament seat"}
        >
          <% seat_idx = tournament_player_index(@tournament_players, seat.opponent.id) %>
          <% seat_stack = Enum.at(@game_view.player_stacks, seat_idx, 0) %>
          <% seat_all_in? = @game_view.round != "Complete" and Enum.at(@game_view.player_all_in, seat_idx, false) %>
          <button
            type="button"
            phx-click="show-bot-profile"
            phx-value-profile-id={seat.opponent.id}
            aria-label={"View #{seat.opponent.name}'s playstyle"}
            title={"View #{seat.opponent.name}'s playstyle"}
            data-retention-event="opponent.profile_opened"
            data-study-screen="play"
            data-study-control="profile_open"
            data-study-opponent-id={seat.opponent.id}
            class="play-tournament-avatar-button"
          >
            <img src={character_image_path(seat.opponent.id)} alt="" />
          </button>
          <strong><%= seat.opponent.name %></strong>
          <span class="play-tournament-seat-role"><%= role_text(@game_view, seat_idx) %></span>
          <span :if={seat_stack > 0} class="play-player-stack">
            <span class="play-stack-chip" aria-hidden="true"></span><%= chip_text(seat_stack) %>
          </span>
          <span :if={seat_all_in?} class="play-tournament-seat-status is-all-in">ALL IN</span>
          <span :if={seat_stack <= 0 and not seat_all_in?} class="play-tournament-seat-status">OUT</span>
        </aside>
      </div>
    </div>

    <div class="play-bottom">
      <div class="play-hud" aria-label="Hand information">
        <div class="play-street-history" role="group" aria-label="Action history by street">
          <section
            :for={{street, short_name} <- @streets}
            class={["play-street-card", @history_street == street && "is-active"]}
            aria-label={"#{street} actions"}
            aria-current={if @history_street == street, do: "step", else: nil}
          >
            <h2 class="play-street-heading"><%= short_name %></h2>
            <ul class="play-street-actions">
              <li :for={action <- actions_for_street(@action_history, street)} class="play-street-action" title={if action, do: "#{action.actor}: #{action.text}", else: nil}>
                <span :if={action} class={if action.actor == "You", do: "play-history-hero", else: "play-history-bot"} aria-hidden="true">
                  <%= if action.actor == "You", do: "YOU", else: action.actor %>
                </span>
                <span :if={action} class="play-street-action-text"><%= action.text %></span>
                <span :if={is_nil(action)} class="play-street-empty" aria-hidden="true">—</span>
              </li>
            </ul>
          </section>
        </div>
        <div class="play-to-call" aria-label={"To call #{chip_text(@game_view.to_call)} chips"}>
          <span>TO CALL</span>
          <strong><%= chip_text(@game_view.to_call) %></strong>
        </div>
      </div>

      <div class="play-status" role="status" aria-live="polite">
        <p :if={@bot_thinking} class="play-thinking-message"><%= @bot_thinking_name || @opponent.name %> is thinking…</p>
        <p :if={@game_message} class={[@game_view.round == "Complete" && "play-result-message", "text-[#E2DCE5]"]}><%= @game_message %></p>
        <p :if={@game_error} class="text-rose-200"><%= @game_error %></p>
      </div>

      <div class="play-actions">
        <button
          :if={@game_view.human_action_enabled}
          id="fold-action"
          type="button"
          phx-click="player-action"
          phx-value-action="fold"
          data-retention-event="ui.interaction"
          data-study-screen="play"
          data-study-control="player_action"
          data-study-action="fold"
          data-study-street={String.downcase(@game_view.round)}
          class="border-white/15 bg-[#2C1320] min-h-11 rounded-xl border px-3 text-sm font-bold text-white transition hover:bg-[#4A263C] focus-visible:outline-poker-gold focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 active:scale-[0.98]"
        >
          Fold
        </button>

        <button
          :if={@game_view.human_action_enabled}
          id="primary-player-action"
          type={if @raise_adjusted, do: "submit", else: "button"}
          form={if @raise_adjusted, do: "raise-form", else: nil}
          phx-click={if @raise_adjusted, do: nil, else: "player-action"}
          phx-value-action={if @game_view.to_call > 0, do: "call", else: "check"}
          data-retention-event="ui.interaction"
          data-study-screen="play"
          data-study-control="player_action"
          data-study-action={if @game_view.to_call > 0, do: "call", else: "check"}
          data-study-street={String.downcase(@game_view.round)}
          class="bg-poker-gold text-[#2C1320] min-h-11 shadow-black/20 rounded-xl px-3 text-sm font-extrabold shadow-md transition hover:bg-poker-gold-light focus-visible:outline-poker-gold focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 active:scale-[0.98]"
        >
          <%= cond do %>
            <% @raise_adjusted && @game_view.to_call == 0 -> %>
              Bet <%= @raise_to %>
            <% @raise_adjusted -> %>
              Raise to <%= @raise_to %>
            <% @game_view.to_call > 0 -> %>
              Call <%= chip_text(@game_view.to_call) %>
            <% true -> %>
              Check
          <% end %>
        </button>

        <form
          :if={raise_available?(@game_view) && @game_view.min_raise <= @game_view.max_raise}
          id="raise-form"
          phx-change="set-raise-size"
          phx-submit="raise"
          class="border-white/10 bg-[#2C1320]/75 grid-cols-[1fr_auto] col-span-2 grid items-center gap-x-2 gap-y-0 rounded-xl border px-2 py-1 sm:col-span-1 sm:gap-x-3 sm:px-3 sm:py-1.5"
        >
          <div class="col-span-2 grid min-w-0 grid-cols-2 items-center gap-2">
            <button
              :if={@raise_adjusted}
              type="button"
              phx-click="player-action"
              phx-value-action={if @game_view.to_call > 0, do: "call", else: "check"}
              data-retention-event="ui.interaction"
              data-study-screen="play"
              data-study-control="player_action"
              data-study-action={if @game_view.to_call > 0, do: "call", else: "check"}
              data-study-street={String.downcase(@game_view.round)}
              aria-label={if @game_view.to_call > 0, do: "Call instead of raising", else: "Check instead of betting"}
              class="border-[#A7ADC6]/30 bg-[#5F4B66] min-h-11 text-[#F2F1F6] w-full whitespace-nowrap rounded-lg border px-2 text-xs font-bold transition hover:bg-[#735C79] focus-visible:outline-poker-gold focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 active:scale-[0.98]"
            >
              <%= if @game_view.to_call > 0, do: "Call instead", else: "Check instead" %>
            </button>
            <button
              type="button"
              phx-click="raise-ten-percent"
              data-retention-event="ui.interaction"
              data-study-screen="play"
              data-study-control="raise_more"
              data-study-street={String.downcase(@game_view.round)}
              title="Add 10% of your remaining stack to the selected amount"
              class="border-[#A7ADC6]/30 bg-[#5F4B66] min-h-11 min-w-14 text-[#F2F1F6] col-start-2 w-full whitespace-nowrap rounded-lg border px-2 text-xs font-extrabold transition hover:bg-[#735C79] focus-visible:outline-poker-gold focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 active:scale-[0.98]"
              aria-label="Increase selected bet by 10 percent of your remaining stack"
            >
              +10%
            </button>
          </div>
          <input
            id="raise-to"
            name="amount"
            type="range"
            min={@game_view.min_raise}
            max={@game_view.max_raise}
            step="1"
            value={@raise_to}
            class="poker-raise-slider accent-poker-gold col-span-2 w-full cursor-pointer"
            aria-label={if @game_view.to_call == 0, do: "Bet amount", else: "Raise amount"}
            aria-describedby="raise-limits"
          />
          <p id="raise-limits" class="text-[#A7ADC6] text-[9px] col-span-2 flex justify-between sm:text-[10px]">
            <span><%= chip_text(@game_view.min_raise) %></span>
            <span>Chips</span>
            <span><%= chip_text(@game_view.max_raise) %></span>
          </p>
        </form>

        <span :if={@game_view.round == "Complete"} class="text-white/80 text-sm font-semibold"><%= if(@match_over, do: "Match complete", else: "Hand complete") %></span>
        <button
          :if={@game_view.round == "Complete" && !@match_over}
          id="deal-next-hand"
          type="button"
          phx-click="new-hand"
          phx-disable-with="Dealing…"
          class="bg-poker-gold text-[#2C1320] min-h-11 shadow-black/20 rounded-xl px-5 text-sm font-extrabold shadow-md transition hover:bg-poker-gold-light focus-visible:outline-poker-gold focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 active:scale-[0.98]"
        >
          Deal next hand <.icon name="tabler-arrow-right" class="ml-1 inline h-4 w-4" />
        </button>
        <div :if={@game_view.round == "Complete"} class="play-action-reserve" aria-hidden="true"></div>
      </div>
    </div>
  </section>
<% end %>

<div :if={@win_reward} class="z-[120] bg-black/75 fixed inset-0 flex items-center justify-center p-4" role="presentation">
  <section
    class="border-poker-gold/50 bg-[#2C1320] shadow-black/50 relative w-full max-w-sm overflow-hidden rounded-3xl border p-6 text-center text-white shadow-2xl"
    role="dialog"
    aria-modal="true"
    aria-labelledby="match-victory-title"
    aria-describedby="match-victory-description"
  >
    <div class="from-poker-gold/20 pointer-events-none absolute inset-x-0 top-0 h-24 bg-gradient-to-b to-transparent" aria-hidden="true"></div>
    <div class="relative">
      <span class="border-poker-gold/40 bg-poker-gold/10 text-poker-gold mx-auto flex h-14 w-14 items-center justify-center rounded-full border text-3xl" aria-hidden="true">
        ♛
      </span>
      <p class="text-poker-gold tracking-[0.2em] mt-4 text-xs font-extrabold uppercase">Victory</p>
      <h2 id="match-victory-title" class="mt-1 text-3xl font-black"><%= if @win_reward.tournament?, do: "Tournament won!", else: "Match won!" %></h2>
      <p id="match-victory-description" class="text-[#D3CDDA] mt-2 text-sm">
        <%= if @win_reward.tournament?, do: "You conquered the family field and earned:", else: "You defeated #{@opponent.name} and earned:" %>
      </p>

      <div class="mt-6 grid grid-cols-2 gap-3">
        <div class="border-poker-gold/25 bg-poker-gold/10 rounded-2xl border px-3 py-4">
          <span class="text-poker-gold mx-auto flex items-center justify-center gap-2 text-xs font-bold uppercase tracking-wider">
            <span class="play-stack-chip" aria-hidden="true"></span> Chips
          </span>
          <strong class="mt-2 block text-2xl font-black text-white">+<%= chip_text(@win_reward.chips) %></strong>
        </div>
        <div class="border-white/10 bg-white/5 rounded-2xl border px-3 py-4">
          <span class="text-[#D3CDDA] text-xs font-bold uppercase tracking-wider">Respect</span>
          <strong class="mt-2 block text-2xl font-black text-white">+<%= @win_reward.respect %></strong>
        </div>
      </div>

      <button
        type="button"
        phx-click="continue-after-win"
        class="bg-poker-gold text-[#2C1320] min-h-12 shadow-black/20 mt-6 w-full rounded-xl px-5 text-sm font-extrabold shadow-lg transition hover:bg-poker-gold-light focus-visible:outline-poker-gold focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 active:scale-[0.98]"
      >
        Continue to map <.icon name="tabler-arrow-right" class="ml-1 inline h-4 w-4" />
      </button>
    </div>
  </section>
</div>

<div :if={@selected_bot_profile} class="z-[100] bg-black/70 fixed inset-0 flex items-center justify-center overflow-y-auto p-4">
  <button type="button" phx-click="close-bot-profile" aria-label="Close opponent read" class="absolute inset-0 h-full w-full cursor-default"></button>
  <section
    class="border-[#8797AF]/50 bg-[#2C1320] max-h-[calc(100dvh-2rem)] relative z-10 w-full max-w-md overflow-y-auto rounded-2xl border p-5 text-white shadow-2xl"
    role="dialog"
    aria-modal="true"
    aria-labelledby="opponent-read-title"
  >
    <div class="flex items-start justify-between gap-3">
      <div>
        <p class="text-poker-gold text-xs font-bold uppercase tracking-widest">Bot playstyle</p>
        <h2 id="opponent-read-title" class="mt-1 text-2xl font-bold"><%= @selected_bot_profile.opponent.name %></h2>
      </div>
      <button type="button" phx-click="close-bot-profile" aria-label="Close opponent read" class="text-[#A7ADC6] rounded-lg px-3 py-2 hover:bg-white/10">✕</button>
    </div>
    <section :if={@selected_bot_profile.simulated} class="border-white/10 bg-white/5 mt-4 rounded-xl border p-4">
      <div class="flex items-start justify-between gap-3">
        <div>
          <p class="text-[#A7ADC6] text-xs font-semibold uppercase tracking-wider">Playstyle</p>
          <p class="mt-1 text-lg font-bold text-white"><%= @selected_bot_profile.simulated["style_title"] %></p>
        </div>
      </div>
      <svg
        viewBox="0 0 240 200"
        class="max-w-[240px] mx-auto mt-2 h-40 w-full"
        role="img"
        aria-label={"#{@selected_bot_profile.simulated["style_title"]} playstyle. Tight to loose #{@selected_bot_profile.simulated["vpip_percentage"]} percent; passive to aggressive #{@selected_bot_profile.simulated["aggression_percentage"]} percent."}
      >
        <defs>
          <linearGradient id="bot-tight-gradient" gradientUnits="userSpaceOnUse" x1="55" y1="0" x2="120" y2="0">
            <stop offset="0%" stop-color="#E89A3A" stop-opacity=".28" /><stop offset="100%" stop-color="#E89A3A" stop-opacity="0" />
          </linearGradient>
          <linearGradient id="bot-loose-gradient" gradientUnits="userSpaceOnUse" x1="120" y1="0" x2="185" y2="0">
            <stop offset="0%" stop-color="#56BD78" stop-opacity="0" /><stop offset="100%" stop-color="#56BD78" stop-opacity=".28" />
          </linearGradient>
          <linearGradient id="bot-aggressive-gradient" gradientUnits="userSpaceOnUse" x1="0" y1="35" x2="0" y2="100">
            <stop offset="0%" stop-color="#E45B5B" stop-opacity=".3" /><stop offset="100%" stop-color="#E45B5B" stop-opacity="0" />
          </linearGradient>
          <linearGradient id="bot-passive-gradient" gradientUnits="userSpaceOnUse" x1="0" y1="100" x2="0" y2="165">
            <stop offset="0%" stop-color="#579CE0" stop-opacity="0" /><stop offset="100%" stop-color="#579CE0" stop-opacity=".3" />
          </linearGradient>
        </defs>
        <rect x="55" y="35" width="65" height="130" fill="url(#bot-tight-gradient)" />
        <rect x="120" y="35" width="65" height="130" fill="url(#bot-loose-gradient)" />
        <rect x="55" y="35" width="130" height="65" fill="url(#bot-aggressive-gradient)" />
        <rect x="55" y="100" width="130" height="65" fill="url(#bot-passive-gradient)" />
        <rect x="55" y="35" width="130" height="130" fill="none" stroke="#8797AF" stroke-opacity=".55" />
        <line x1="120" y1="35" x2="120" y2="165" stroke="#8797AF" stroke-opacity=".4" />
        <line x1="55" y1="100" x2="185" y2="100" stroke="#8797AF" stroke-opacity=".4" />
        <circle
          cx={55 + 1.3 * @selected_bot_profile.simulated["vpip_percentage"]}
          cy={165 - 1.3 * @selected_bot_profile.simulated["aggression_percentage"]}
          r="7"
          fill={@selected_bot_profile.simulated["graph_color"]}
          stroke="#2C1320"
          stroke-width="2"
        />
        <text x="120" y="22" text-anchor="middle" fill="#F08080" font-size="10" font-weight="600">Aggressive</text>
        <text x="120" y="184" text-anchor="middle" fill="#78B7F0" font-size="10" font-weight="600">Passive</text>
        <text x="47" y="103" text-anchor="end" fill="#F0B05D" font-size="10" font-weight="600">Tight</text>
        <text x="193" y="103" text-anchor="start" fill="#79D296" font-size="10" font-weight="600">Loose</text>
      </svg>
      <div class="mt-2 space-y-3">
        <section>
          <h3 class="text-[#A7ADC6] text-xs font-bold uppercase tracking-wider">Pre-flop</h3>
          <dl class="mt-2 grid grid-cols-3 gap-2 text-sm">
            <div class="bg-black/20 rounded-lg p-3">
              <dt class="text-[#A7ADC6] flex items-center gap-1">
                VPIP
                <.metric_info label="VPIP" description="The percentage of dealt hands where this bot voluntarily calls or raises before the flop. Forced blinds are excluded." />
              </dt>
              <dd class="mt-1 text-lg font-bold"><%= @selected_bot_profile.simulated["vpip_percentage"] %>%</dd>
            </div>
            <div class="bg-black/20 rounded-lg p-3">
              <dt class="text-[#A7ADC6] flex items-center gap-1">
                PFR <.metric_info label="PFR" description="The percentage of dealt hands where this bot raises before the flop." />
              </dt>
              <dd class="mt-1 text-lg font-bold"><%= @selected_bot_profile.simulated["pfr_percentage"] %>%</dd>
            </div>
            <div class="bg-black/20 rounded-lg p-3">
              <dt class="text-[#A7ADC6] flex items-center gap-1">
                3-Bet <.metric_info label="3-Bet" description="How often this bot re-raises after facing a pre-flop raise, out of those opportunities." align={:end} />
              </dt>
              <dd class="mt-1 text-lg font-bold">
                <%= if is_nil(@selected_bot_profile.simulated["three_bet_percentage"]), do: "—", else: "#{@selected_bot_profile.simulated["three_bet_percentage"]}%" %>
              </dd>
            </div>
          </dl>
        </section>
        <section>
          <h3 class="text-[#A7ADC6] text-xs font-bold uppercase tracking-wider">Post-flop</h3>
          <dl class="mt-2 grid grid-cols-3 gap-2 text-sm">
            <div class="bg-black/20 rounded-lg p-3">
              <dt class="text-[#A7ADC6] flex items-center gap-1">
                C-Bet
                <.metric_info
                  label="C-Bet"
                  description="How often this bot bets the flop when it was the last pre-flop raiser and could act without facing a bet."
                  placement={:above}
                />
              </dt>
              <dd class="mt-1 text-lg font-bold">
                <%= if is_nil(@selected_bot_profile.simulated["cbet_percentage"]), do: "—", else: "#{@selected_bot_profile.simulated["cbet_percentage"]}%" %>
              </dd>
            </div>
            <div class="bg-black/20 rounded-lg p-3">
              <dt class="text-[#A7ADC6] flex items-center gap-1">
                AF <.metric_info label="AF" description="Post-flop bets and raises divided by post-flop calls. This is a ratio, not a percentage." placement={:above} />
              </dt>
              <dd class="mt-1 text-lg font-bold"><%= @selected_bot_profile.simulated["aggression_factor"] || "—" %></dd>
            </div>
            <div class="bg-black/20 rounded-lg p-3">
              <dt class="text-[#A7ADC6] flex items-center gap-1">
                WTSD <.metric_info label="WTSD" description="The percentage of hands where this bot saw the flop and then reached showdown." align={:end} placement={:above} />
              </dt>
              <dd class="mt-1 text-lg font-bold">
                <%= if is_nil(@selected_bot_profile.simulated["wtsd_percentage"]), do: "—", else: "#{@selected_bot_profile.simulated["wtsd_percentage"]}%" %>
              </dd>
            </div>
          </dl>
        </section>
      </div>
    </section>

    <p :if={!@selected_bot_profile.simulated} class="border-white/10 bg-white/5 text-[#A7ADC6] mt-4 rounded-xl border p-3 text-sm">
      Playstyle data is unavailable. Generate it with <code>mix pokerdex.simulate_bot_profiles --hands 1000</code>.
    </p>
  </section>
</div>

<div :if={@show_hand_rankings} class="z-[100] bg-black/70 fixed inset-0 flex items-center justify-center overflow-y-auto p-4">
  <button type="button" phx-click="close-hand-rankings" aria-label="Close hand rankings" class="absolute inset-0 h-full w-full cursor-default"></button>
  <section
    class="border-[#8797AF]/50 bg-[#2C1320] max-h-[calc(100dvh-2rem)] relative z-10 w-full max-w-lg overflow-y-auto rounded-2xl border p-5 text-white shadow-2xl"
    role="dialog"
    aria-modal="true"
    aria-labelledby="hand-rankings-title"
    phx-window-keydown="close-hand-rankings"
    phx-key="escape"
  >
    <header class="flex items-start justify-between gap-3">
      <div>
        <p class="text-poker-gold text-xs font-bold uppercase tracking-widest">Texas Hold’em</p>
        <h2 id="hand-rankings-title" class="mt-1 text-2xl font-bold">Hand Rankings</h2>
        <p class="text-[#A7ADC6] mt-1 text-sm">Strongest to weakest · tap a hand to learn more</p>
      </div>
      <button type="button" phx-click="close-hand-rankings" aria-label="Close hand rankings" class="text-[#A7ADC6] rounded-lg px-3 py-2 hover:bg-white/10">✕</button>
    </header>

    <ol class="mt-4 grid grid-cols-2 gap-2">
      <li :for={{ranking, index} <- Enum.with_index(@hand_rankings, 1)}>
        <button
          type="button"
          phx-click="select-hand-ranking"
          phx-value-ranking={ranking.id}
          aria-pressed={@selected_hand_ranking.id == ranking.id}
          class={[
            "border-white/10 bg-white/5 min-h-12 flex w-full items-center gap-2 rounded-xl border px-3 py-2 text-left text-sm font-semibold transition",
            @selected_hand_ranking.id == ranking.id && "border-poker-gold/70 bg-poker-gold/15 text-poker-gold",
            @selected_hand_ranking.id != ranking.id && "text-white hover:border-poker-gold/50 hover:bg-white/10"
          ]}
        >
          <span class="text-[#A7ADC6] w-5 shrink-0 text-xs"><%= index %></span>
          <span><%= ranking.name %></span>
        </button>
      </li>
    </ol>

    <section class="border-poker-gold/30 bg-black/20 mt-4 rounded-xl border p-4" aria-live="polite">
      <p class="text-poker-gold text-xs font-bold uppercase tracking-wider">#<%= Enum.find_index(@hand_rankings, &(&1.id == @selected_hand_ranking.id)) + 1 %></p>
      <h3 class="mt-1 text-lg font-bold"><%= @selected_hand_ranking.name %></h3>
      <p class="text-[#D3CDDA] mt-2 text-sm leading-relaxed"><%= @selected_hand_ranking.description %></p>
    </section>
  </section>
</div>
