<section class="border-[#5F4B66] bg-[#2C1320] relative mx-auto my-6 w-full max-w-4xl overflow-hidden rounded-3xl border px-4 py-7 shadow-2xl sm:px-8 sm:py-9">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 opacity-40" style="background: radial-gradient(ellipse at 50% -10%, #5F4B66 0%, transparent 58%)"></div>

  <div class="relative z-10">
    <header class="mb-7 flex items-center gap-3">
      <span aria-hidden="true" class="border-[#A7ADC6]/60 bg-[#56667A]/50 flex h-11 w-11 items-center justify-center rounded-full border text-2xl text-white shadow-inner">
        ♠
      </span>
      <div>
        <p class="tracking-[0.2em] text-[#A7ADC6] text-xs font-bold uppercase">PokerDex</p>
        <h1 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">Progress</h1>
      </div>
    </header>

    <div class="grid items-start gap-4 sm:grid-cols-2">
      <section
        id="play-progress"
        class="border-[#8797AF]/60 from-[#5F4B66] to-[#2C1320] shadow-black/20 rounded-2xl border bg-gradient-to-br p-5 shadow-xl sm:col-span-2 sm:p-6"
      >
        <div class="flex items-center gap-3">
          <span aria-hidden="true" class="border-white/40 bg-[#2C1320]/30 flex h-11 w-11 shrink-0 items-center justify-center rounded-full border text-2xl text-white">
            ♦
          </span>
          <h2 class="text-xl font-bold text-white">Play</h2>
        </div>

        <div class="mt-4 grid grid-cols-2 gap-3">
          <div class="border-white/15 bg-[#2C1320]/70 rounded-xl border p-4">
            <p class="text-[#A7ADC6] text-sm">Total win percentage</p>
            <p class="mt-1 text-2xl font-bold text-white">
              <%= if is_nil(@play_progress.total.win_percentage), do: "—", else: "#{@play_progress.total.win_percentage}%" %>
            </p>
          </div>
          <div class="border-white/15 bg-[#2C1320]/70 rounded-xl border p-4">
            <p class="text-[#A7ADC6] text-sm">Games played</p>
            <p class="mt-1 text-2xl font-bold text-white"><%= @play_progress.total.games_played %></p>
          </div>
        </div>

        <div class="border-white/10 bg-[#2C1320]/45 mt-4 flex flex-col items-center gap-3 rounded-xl border p-4 sm:flex-row sm:items-center">
          <div class="max-w-[240px] w-full shrink-0">
            <svg
              viewBox="0 0 240 200"
              class="h-44 w-full"
              role="img"
              aria-label={"Playstyle chart: #{@playstyle.title}. Tight to loose #{@playstyle.looseness_percentage} percent; passive to aggressive #{@playstyle.aggression_percentage} percent."}
            >
              <defs>
                <linearGradient id="tight-gradient" gradientUnits="userSpaceOnUse" x1="55" y1="0" x2="120" y2="0">
                  <stop offset="0%" stop-color="#E89A3A" stop-opacity=".28" />
                  <stop offset="100%" stop-color="#E89A3A" stop-opacity="0" />
                </linearGradient>
                <linearGradient id="loose-gradient" gradientUnits="userSpaceOnUse" x1="120" y1="0" x2="185" y2="0">
                  <stop offset="0%" stop-color="#56BD78" stop-opacity="0" />
                  <stop offset="100%" stop-color="#56BD78" stop-opacity=".28" />
                </linearGradient>
                <linearGradient id="aggressive-gradient" gradientUnits="userSpaceOnUse" x1="0" y1="35" x2="0" y2="100">
                  <stop offset="0%" stop-color="#E45B5B" stop-opacity=".3" />
                  <stop offset="100%" stop-color="#E45B5B" stop-opacity="0" />
                </linearGradient>
                <linearGradient id="passive-gradient" gradientUnits="userSpaceOnUse" x1="0" y1="100" x2="0" y2="165">
                  <stop offset="0%" stop-color="#579CE0" stop-opacity="0" />
                  <stop offset="100%" stop-color="#579CE0" stop-opacity=".3" />
                </linearGradient>
              </defs>
              <rect x="55" y="35" width="65" height="130" fill="url(#tight-gradient)" />
              <rect x="120" y="35" width="65" height="130" fill="url(#loose-gradient)" />
              <rect x="55" y="35" width="130" height="65" fill="url(#aggressive-gradient)" />
              <rect x="55" y="100" width="130" height="65" fill="url(#passive-gradient)" />
              <rect x="55" y="35" width="130" height="130" fill="none" stroke="#8797AF" stroke-opacity=".55" />
              <rect x="71.25" y="51.25" width="97.5" height="97.5" fill="none" stroke="#8797AF" stroke-opacity=".4" />
              <rect x="87.5" y="67.5" width="65" height="65" fill="none" stroke="#8797AF" stroke-opacity=".3" />
              <rect x="103.75" y="83.75" width="32.5" height="32.5" fill="none" stroke="#8797AF" stroke-opacity=".22" />
              <line x1="120" y1="35" x2="120" y2="165" stroke="#8797AF" stroke-opacity=".4" />
              <line x1="55" y1="100" x2="185" y2="100" stroke="#8797AF" stroke-opacity=".4" />
              <circle
                :if={@playstyle.hands_seen > 0}
                cx={@playstyle.chart_position.x}
                cy={@playstyle.chart_position.y}
                r="6"
                fill={@playstyle.graph_color}
                stroke="#2C1320"
                stroke-width="2"
              />
              <circle :if={@playstyle.hands_seen == 0} cx="120" cy="100" r="5" fill="#8797AF" />
              <text x="120" y="22" text-anchor="middle" fill="#F08080" font-size="10" font-weight="600">Aggressive</text>
              <text x="120" y="184" text-anchor="middle" fill="#78B7F0" font-size="10" font-weight="600">Passive</text>
              <text x="47" y="103" text-anchor="end" fill="#F0B05D" font-size="10" font-weight="600">Tight</text>
              <text x="193" y="103" text-anchor="start" fill="#79D296" font-size="10" font-weight="600">Loose</text>
            </svg>
          </div>
          <div class="w-full">
            <p class="text-[#A7ADC6] text-xs font-semibold uppercase tracking-wider">Your playstyle</p>
            <p class="mt-1 text-xl font-bold text-white"><%= @playstyle.title %></p>
            <p class="text-[#A7ADC6] mt-1 text-xs">
              <%= if @playstyle.hands_seen == 0 do %>
                Play a few hands to build a read
              <% else %>
                <%= @playstyle.sample_label %> · <%= @playstyle.hands_seen %>
                <%= if @playstyle.hands_seen == 1, do: "hand", else: "hands" %> observed
              <% end %>
            </p>
            <div class="mt-3 space-y-3">
              <section>
                <h3 class="text-[#A7ADC6] text-xs font-bold uppercase tracking-wider">Pre-flop</h3>
                <dl class="mt-2 grid grid-cols-3 gap-2 text-xs">
                  <div class="border-white/10 bg-[#2C1320]/60 rounded-lg border p-2">
                    <dt class="text-[#A7ADC6] flex items-center gap-1">
                      VPIP
                      <.metric_info label="VPIP" description="The percentage of dealt hands where you voluntarily call or raise before the flop. Forced blinds are excluded." />
                    </dt>
                    <dd class="mt-1 font-semibold text-white"><%= if @playstyle.hands_seen == 0, do: "—", else: "#{@playstyle.vpip_percentage}%" %></dd>
                  </div>
                  <div class="border-white/10 bg-[#2C1320]/60 rounded-lg border p-2">
                    <dt class="text-[#A7ADC6] flex items-center gap-1">
                      PFR <.metric_info label="PFR" description="The percentage of dealt hands where you raise before the flop." />
                    </dt>
                    <dd class="mt-1 font-semibold text-white"><%= if @playstyle.hands_seen == 0, do: "—", else: "#{@playstyle.pfr_percentage}%" %></dd>
                  </div>
                  <div class="border-white/10 bg-[#2C1320]/60 rounded-lg border p-2">
                    <dt class="text-[#A7ADC6] flex items-center gap-1">
                      3-Bet <.metric_info label="3-Bet" description="How often you re-raise after facing a pre-flop raise, out of those opportunities." align={:end} />
                    </dt>
                    <dd class="mt-1 font-semibold text-white"><%= if is_nil(@playstyle.three_bet_percentage), do: "—", else: "#{@playstyle.three_bet_percentage}%" %></dd>
                  </div>
                </dl>
              </section>
              <section>
                <h3 class="text-[#A7ADC6] text-xs font-bold uppercase tracking-wider">Post-flop</h3>
                <dl class="mt-2 grid grid-cols-3 gap-2 text-xs">
                  <div class="border-white/10 bg-[#2C1320]/60 rounded-lg border p-2">
                    <dt class="text-[#A7ADC6] flex items-center gap-1">
                      C-Bet
                      <.metric_info
                        label="C-Bet"
                        description="How often you bet the flop when you were the last pre-flop raiser and could act without facing a bet."
                        placement={:above}
                      />
                    </dt>
                    <dd class="mt-1 font-semibold text-white"><%= if is_nil(@playstyle.cbet_percentage), do: "—", else: "#{@playstyle.cbet_percentage}%" %></dd>
                  </div>
                  <div class="border-white/10 bg-[#2C1320]/60 rounded-lg border p-2">
                    <dt class="text-[#A7ADC6] flex items-center gap-1">
                      AF <.metric_info label="AF" description="Post-flop bets and raises divided by post-flop calls. This is a ratio, not a percentage." placement={:above} />
                    </dt>
                    <dd class="mt-1 font-semibold text-white"><%= @playstyle.aggression_factor || "—" %></dd>
                  </div>
                  <div class="border-white/10 bg-[#2C1320]/60 rounded-lg border p-2">
                    <dt class="text-[#A7ADC6] flex items-center gap-1">
                      WTSD
                      <.metric_info label="WTSD" description="The percentage of hands where you saw the flop and then reached showdown." align={:end} placement={:above} />
                    </dt>
                    <dd class="mt-1 font-semibold text-white"><%= if is_nil(@playstyle.wtsd_percentage), do: "—", else: "#{@playstyle.wtsd_percentage}%" %></dd>
                  </div>
                </dl>
              </section>
            </div>
          </div>
        </div>
      </section>

      <section id="puzzles-progress" class="border-[#8797AF]/70 bg-[#56667A] shadow-black/20 rounded-2xl border p-5 shadow-xl">
        <div class="flex items-center justify-between gap-3">
          <h2 class="text-xl font-bold text-white">Puzzles</h2>
          <span aria-hidden="true" class="border-white/40 bg-[#2C1320]/30 flex h-9 w-9 items-center justify-center rounded-full border text-lg text-white">♣</span>
        </div>
        <div class="mt-4 grid grid-cols-2 gap-3">
          <div class="border-white/15 bg-[#2C1320]/70 rounded-xl border p-3">
            <p class="text-[#A7ADC6] text-sm">Accuracy</p>
            <p class="mt-1 text-2xl font-bold text-white"><%= @puzzle_progress.accuracy_percentage %>%</p>
          </div>
          <div class="border-white/15 bg-[#2C1320]/70 rounded-xl border p-3">
            <p class="text-[#A7ADC6] text-sm">Completed</p>
            <p class="mt-1 text-2xl font-bold text-white"><%= @puzzle_progress.completed_count %></p>
          </div>
        </div>
        <details class="mt-4 text-sm">
          <summary class="cursor-pointer font-semibold text-white marker:text-[#A7ADC6]">By street</summary>
          <ul class="divide-white/10 mt-2 divide-y">
            <li :for={street <- @puzzle_progress.streets} class="flex items-center justify-between gap-3 py-2">
              <span class="text-[#A7ADC6]"><%= street.title %> · <%= street.completed_count %> completed</span>
              <span class="font-semibold text-white"><%= street.accuracy_percentage %>%</span>
            </li>
          </ul>
        </details>
      </section>

      <section id="theory-progress" class="border-[#8797AF]/70 bg-[#5F4B66] shadow-black/20 rounded-2xl border p-5 shadow-xl">
        <div class="flex items-center justify-between gap-3">
          <h2 class="text-xl font-bold text-white">Theory</h2>
          <span aria-hidden="true" class="border-white/40 bg-[#2C1320]/30 flex h-9 w-9 items-center justify-center rounded-full border text-lg text-white">♥</span>
        </div>
        <div class="mt-4 grid grid-cols-2 gap-3">
          <div class="border-white/15 bg-[#2C1320]/70 rounded-xl border p-3">
            <p class="text-[#A7ADC6] text-sm">Lessons complete</p>
            <p class="mt-1 text-2xl font-bold text-white"><%= @theory_progress.overall.lessons_percentage %>%</p>
          </div>
          <div class="border-white/15 bg-[#2C1320]/70 rounded-xl border p-3">
            <p class="text-[#A7ADC6] text-sm">Answer accuracy</p>
            <p class="mt-1 text-2xl font-bold text-white"><%= @theory_progress.overall.accuracy_percentage %>%</p>
          </div>
        </div>
        <details :if={@theory_progress.difficulties != []} class="mt-4 text-sm">
          <summary class="cursor-pointer font-semibold text-white marker:text-[#A7ADC6]">By difficulty</summary>
          <ul class="divide-white/10 mt-2 divide-y">
            <li :for={difficulty <- @theory_progress.difficulties} class="flex items-center justify-between gap-3 py-2">
              <span class="text-[#A7ADC6]"><%= difficulty.title %> · lessons <%= difficulty.stats.lessons_percentage %>%</span>
              <span class="font-semibold text-white"><%= difficulty.stats.accuracy_percentage %>% accuracy</span>
            </li>
          </ul>
        </details>
      </section>
    </div>
  </div>
</section>
