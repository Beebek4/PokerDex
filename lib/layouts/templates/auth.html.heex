<header class="flex items-center justify-between p-4 sm:px-6 lg:px-8">
  <.link href={~p"/"}>
    <img src={school_logo(@school, @app)} alt={school_name(@school)} class="h-14 w-64 max-w-full object-cover object-center" />
  </.link>
</header>

<main class="p-4 sm:px-6 lg:px-8">
  <.flash_group flash={@flash} />
  <%= @inner_content %>
</main>
