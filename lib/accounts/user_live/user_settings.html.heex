<section :if={@live_action == :avatar} id="avatar-settings" class="min-h-dvh text-white">
  <header class="top-[57px] border-white/10 bg-[#5F4B66] sticky flex flex-wrap items-center gap-3 border-b p-4 sm:px-6 lg:px-8">
    <h1 class="text-base font-semibold leading-7 text-white"><%= gettext("Avatar") %></h1>
    <span class="text-[#E2DCE5] ml-auto text-xs font-medium">Changes save automatically</span>
  </header>

  <div class="container mx-auto max-w-4xl">
    <div class="mb-5">
      <h2 class="text-xl font-bold text-white">Choose your player avatar</h2>
      <p class="text-[#A7ADC6] mt-1 text-sm">Choose a player character for your profile. You can change it any time.</p>
    </div>

    <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4">
      <button
        :for={choice <- @avatar_choices}
        type="button"
        phx-click="choose-avatar"
        phx-value-avatar={choice.image}
        aria-pressed={avatar_selected?(@current_user.avatar, choice.image)}
        class={[
          "group rounded-2xl border p-4 text-center transition focus-visible:outline-poker-gold focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2",
          avatar_selected?(@current_user.avatar, choice.image) && "border-poker-gold bg-[#5F4B66] shadow-black/20 shadow-lg",
          !avatar_selected?(@current_user.avatar, choice.image) && "border-white/10 bg-[#351B2B] hover:border-white/30 hover:bg-[#453047]"
        ]}
      >
        <span class="border-white/15 bg-[#2C1320] mx-auto flex h-20 w-20 items-center justify-center rounded-full border p-4 shadow-inner">
          <img src={choice.image} alt="" class="h-full w-full object-contain" />
        </span>
        <span class="mt-3 block text-sm font-semibold text-white"><%= choice.label %></span>
        <span :if={avatar_selected?(@current_user.avatar, choice.image)} class="text-poker-gold mt-1 block text-xs font-semibold">Selected</span>
      </button>
    </div>

    <p class="text-[#A7ADC6] mt-5 text-xs leading-5">Player characters are used instead of suit icons. More choices can be added later.</p>
  </div>
</section>

<.simple_form
  :if={@live_action not in [:avatar, :delete] and !@current_user.guest?}
  unstyled
  for={@form}
  phx-trigger-action={if @live_action == :password, do: @trigger_submit, else: nil}
  id="settings-form"
  phx-submit="update"
  phx-change="validate"
  action={if @live_action == :password, do: ~p"/users/login?_action=password_updated", else: nil}
  method={if @live_action == :password, do: "post", else: nil}
>
  <div class="top-[57px] border-white/10 bg-[#5F4B66] sticky flex flex-wrap items-center gap-2 border-b p-4 text-white sm:flex-nowrap sm:px-6 lg:px-8">
    <h1 class="text-base font-semibold leading-7 text-white"><%= get_page_title(@live_action) %></h1>

    <.button type="submit" icon="tabler-checks" class="ml-auto" phx-disable-with={gettext("Saving...")}>
      <%= gettext("Save") %>
    </.button>
  </div>

  <div class="container max-w-3xl space-y-8 text-white">
    <.input
      :if={@live_action == :profile}
      field={@form[:language]}
      type="select"
      label={gettext("Language")}
      options={ZoonkWeb.Plugs.Translate.language_options()}
      value={@current_user.language}
      required
    />

    <.input :if={@live_action == :profile} field={@form[:username]} type="text" label={gettext("Username")} autocomplete="username" required />
    <.input :if={@live_action == :profile} field={@form[:first_name]} type="text" label={gettext("First Name")} autocomplete="given-name" />
    <.input :if={@live_action == :profile} field={@form[:last_name]} type="text" label={gettext("Last Name")} autocomplete="family-name" />

    <.input
      :if={@live_action == :profile}
      field={@form[:sound_effects?]}
      type="checkbox"
      label={dgettext("auth", "Enable sound effects?")}
      helper={dgettext("auth", "When checked, courses may play sound effects when you answer questions correctly or incorrectly.")}
    />

    <.input :if={@live_action == :email} field={@form[:email]} type="email" label={gettext("Email")} required />
    <.input :if={@live_action == :password} field={@form[:email]} type="hidden" value={@current_user.email} />

    <.input
      :if={@live_action in [:email, :password]}
      field={@form[:current_password]}
      name="current_password"
      id="current_password"
      type="password"
      label={dgettext("auth", "Current password")}
      value={@current_password}
      required
    />

    <.input :if={@live_action == :password} field={@form[:password]} type="password" label={dgettext("auth", "New password")} autocomplete="new-password" required />
    <.input :if={@live_action == :password} field={@form[:password_confirmation]} type="password" label={dgettext("auth", "Confirm new password")} autocomplete="new-password" />
  </div>
</.simple_form>

<.simple_form :if={@live_action == :profile and @current_user.guest?} unstyled for={@form} id="settings-form" phx-submit="update" phx-change="validate">
  <div class="top-[57px] border-white/10 bg-[#5F4B66] sticky flex flex-wrap items-center gap-2 border-b p-4 text-white sm:flex-nowrap sm:px-6 lg:px-8">
    <h1 class="text-base font-semibold leading-7 text-white"><%= get_page_title(@live_action) %></h1>

    <.button type="submit" icon="tabler-checks" class="ml-auto" phx-disable-with={gettext("Saving...")}>
      <%= gettext("Save") %>
    </.button>
  </div>

  <div class="container max-w-3xl space-y-8 text-white">
    <span class="text-[#E2E6EF] text-sm">
      <%= dgettext("auth", "You have a guest account. To convert it into a regular account, update your email address below:") %>
    </span>

    <.input field={@form[:language]} type="select" label={gettext("Language")} options={ZoonkWeb.Plugs.Translate.language_options()} required />
    <.input field={@form[:username]} type="text" label={gettext("Username")} autocomplete="username" required />
    <.input field={@form[:email]} type="email" label={gettext("Email")} required />
    <.input field={@form[:password]} type="password" label={gettext("Password")} autocomplete="new-password" required />
  </div>
</.simple_form>

<.live_component :if={@live_action == :delete} id={:delete_user} module={DeleteItem} name={get_page_title(@live_action)} theme={:poker} />
